<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.ListaProduto"
             Title="Minhas Compras"
             BackgroundColor="#FFF5F5F5">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Label">
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="TextColor" Value="#333333" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="#FFE0E0E0" />
                <Setter Property="TextColor" Value="#333333" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Margin" Value="5" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="TotalLabelStyle" TargetType="Label">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="#2E7D32" />
                <Setter Property="BackgroundColor" Value="#E8F5E9" />
                <Setter Property="Padding" Value="5" />
                <Setter Property="HorizontalTextAlignment" Value="End" />
            </Style>
            <Style TargetType="SearchBar">
                <Setter Property="BackgroundColor" Value="#FFEEEEEE" />
                <Setter Property="TextColor" Value="#333333" />
                <Setter Property="PlaceholderColor" Value="#666666" />
                <Setter Property="CancelButtonColor" Value="#333333" />
            </Style>
            <Style TargetType="Picker">
                <Setter Property="BackgroundColor" Value="#FFEEEEEE" />
                <Setter Property="TextColor" Value="#333333" />
                <Setter Property="TitleColor" Value="#666666" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
        <!-- Barra de busca e filtro - agora com fundo cinza -->
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto" Margin="10,10,10,0">
            <SearchBar x:Name="txt_search"
                   Grid.Column="0"
                   Margin="0,0,5,0"
                   Placeholder="Busca por nome"
                   TextChanged="txt_search_TextChanged"/>

            <Picker x:Name="picker_categorias"
                Grid.Column="1"
                Margin="5,0,0,0"
                Title="Filtrar categoria"
                SelectedIndexChanged="Picker_Categorias_SelectedIndexChanged">
                <Picker.Items>
                    <x:String>Todas</x:String>
                    <x:String>Alimentos</x:String>
                    <x:String>Bebidas</x:String>
                    <x:String>Higiene</x:String>
                    <x:String>Limpeza</x:String>
                    <x:String>Utilitários</x:String>
                    <x:String>Cozinha</x:String>
                    <x:String>Padaria</x:String>
                    <x:String>Outros</x:String>
                </Picker.Items>
            </Picker>
        </Grid>

        <!-- Lista de produtos -->
        <Frame Grid.Row="1" 
               Padding="0" 
               Margin="10,0,10,0" 
               CornerRadius="8"
               BorderColor="#FFD0D0D0"
               BackgroundColor="White">
            <ListView x:Name="lst_produtos"
                  IsPullToRefreshEnabled="True"
                  Refreshing="lst_produtos_Refreshing"
                  ItemSelected="lst_produtos_ItemSelected"
                  SeparatorColor="#FFEEEEEE">
                <ListView.Header>
                    <Grid ColumnDefinitions="30,110,70,60,70,80"
                          BackgroundColor="#FFEEEEEE"
                          Padding="10,8">
                        <Label Grid.Column="0" Text="ID" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="Descrição" FontAttributes="Bold" />
                        <Label Grid.Column="2" Text="Categoria" FontAttributes="Bold" />
                        <Label Grid.Column="3" Text="Qnt" FontAttributes="Bold" />
                        <Label Grid.Column="4" Text="Preço" FontAttributes="Bold" />
                        <Label Grid.Column="5" Text="Total" FontAttributes="Bold" />
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <ViewCell.ContextActions>
                                <MenuItem Text="Remover" Clicked="MenuItem_Clicked" />
                            </ViewCell.ContextActions>
                            <Grid ColumnDefinitions="30,110,70,60,70,80"
                                  Padding="10,8">
                                <Label Grid.Column="0" Text="{Binding Id}" />
                                <Label Grid.Column="1" Text="{Binding Descricao}" LineBreakMode="TailTruncation" />
                                <Label Grid.Column="2" Text="{Binding Categoria}" LineBreakMode="TailTruncation" />
                                <Label Grid.Column="3" Text="{Binding Quantidade}" />
                                <Label Grid.Column="4" Text="{Binding Preco, StringFormat='{}{0:c}'}" />
                                <Label Grid.Column="5" 
                                       Text="{Binding Total, StringFormat='{}{0:c}'}" 
                                       Style="{StaticResource TotalLabelStyle}" />
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Frame>

        <!-- Barra de botões inferior -->
        <Grid Grid.Row="2" 
              ColumnDefinitions="*,*,*" 
              BackgroundColor="#FFEEEEEE"
              Padding="10"
              RowDefinitions="Auto">
            <Button Grid.Column="0" Text="Somar" Clicked="ToolbarItem_Clicked_1" />
            <Button Grid.Column="1" Text="Adicionar" Clicked="ToolbarItem_Clicked" />
            <Button Grid.Column="2" Text="Relátorio" Clicked="ToolbarItem_Clicked_2" />
        </Grid>
    </Grid>
</ContentPage>