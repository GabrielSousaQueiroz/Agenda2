<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.ListaProduto"
             Title="Minhas Compras"
             BackgroundColor="#F5F5F5">
    <!-- Fundo cinza claro para suavidade -->

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Somar" Clicked="ToolbarItem_Clicked_1" />
        <ToolbarItem Text="Adicionar" Clicked="ToolbarItem_Clicked" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Label">
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="TextColor" Value="Black" />
                <Setter Property="FontSize" Value="14"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <StackLayout Padding="10">
        <SearchBar x:Name="txt_search"
                   Placeholder="Buscar produtos..."
                   TextChanged="txt_search_TextChanged"
                   BackgroundColor="White"
                   TextColor="Black"
                   Margin="0,0,0,10"
                   HeightRequest="50"/>

        <Frame Padding="10" BackgroundColor="White" CornerRadius="10" HasShadow="True">
            <ListView x:Name="lst_produtos"
                      IsPullToRefreshEnabled="True"
                      Refreshing="lst_produtos_Refreshing"
                      ItemSelected="lst_produtos_ItemSelected"
                      BackgroundColor="White"
                      SeparatorColor="#B0BEC5">
                <!-- Separador mais suave -->
                <ListView.Header>
                    <Grid ColumnDefinitions="50, 1.5*, 0.8*, 0.5*, 0.5*, 1*, 1*"
                          BackgroundColor="#455A64"
                          Padding="8"
                          ColumnSpacing="10">
                        <Label Grid.Column="0" Text="ID" FontAttributes="Bold" TextColor="White"/>
                        <Label Grid.Column="1" Text="Descrição" FontAttributes="Bold" TextColor="White"/>
                        <Label Grid.Column="2" Text="Preço" FontAttributes="Bold" TextColor="White"/>
                        <Label Grid.Column="3" Text="Qnt" FontAttributes="Bold" TextColor="White"/>
                        <Label Grid.Column="4" Text="Imposto" FontAttributes="Bold" TextColor="White"/>
                        <Label Grid.Column="5" Text="Total" FontAttributes="Bold" TextColor="White"/>
                        <Label Grid.Column="6" Text="Validade" FontAttributes="Bold" TextColor="White"/>
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <ViewCell.ContextActions>
                                <MenuItem Text="Remover" Clicked="MenuItem_Clicked" />
                            </ViewCell.ContextActions>
                            <Frame Padding="5" Margin="5,2,5,2" CornerRadius="8" BackgroundColor="#ECEFF1">
                                <Grid ColumnDefinitions="50, 1.5*, 0.8*, 0.5*, 0.5*, 1*, 1*"
                                      Padding="5"
                                      ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="{Binding Id}" TextColor="Black"/>
                                    <Label Grid.Column="1" Text="{Binding Descricao}" TextColor="Black" FontAttributes="Bold"/>
                                    <Label Grid.Column="2" Text="{Binding Preco, StringFormat='{}{0:c}'}" TextColor="Black"/>
                                    <Label Grid.Column="3" Text="{Binding Quantidade}" TextColor="Black"/>
                                    <Label Grid.Column="4" Text="{Binding Imposto, StringFormat='{}{0}%'}" TextColor="Black"/>
                                    <Label Grid.Column="5" Text="{Binding Total, StringFormat='{}{0:c}'}" TextColor="Black"/>
                                    <Label Grid.Column="6" Text="{Binding DataValidade, StringFormat='{}{0:dd/MM/yyyy}'}" TextColor="Black"/>
                                </Grid>
                            </Frame>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Frame>
    </StackLayout>
</ContentPage>
