<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.NovoProduto"
             Title="Novo Produto"
             BackgroundColor="#F5F5F5">
    <!-- Fundo cinza claro para suavidade -->

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salvar" Clicked="ToolbarItem_Clicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="20">

            <Frame Padding="15" CornerRadius="10" BackgroundColor="White" HasShadow="True">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Descrição do Produto:" FontSize="16" TextColor="Black" FontAttributes="Bold"/>
                    <Entry x:Name="txt_descricao" Placeholder="Digite a descrição..." BackgroundColor="#ECEFF1" TextColor="Black" />

                    <Label Text="Quantidade:" FontSize="16" TextColor="Black" FontAttributes="Bold"/>
                    <Entry x:Name="txt_quantidade" Placeholder="Ex: 2" Keyboard="Numeric" BackgroundColor="#ECEFF1" TextColor="Black"/>

                    <Label Text="Preço Unitário:" FontSize="16" TextColor="Black" FontAttributes="Bold"/>
                    <Entry x:Name="txt_preco" Placeholder="Ex: 10.50" Keyboard="Numeric" BackgroundColor="#ECEFF1" TextColor="Black"/>

                    <Label Text="Imposto (%):" FontSize="16" TextColor="Black" FontAttributes="Bold"/>
                    <Entry x:Name="txt_imposto" Placeholder="Ex: 5" Keyboard="Numeric" BackgroundColor="#ECEFF1" TextColor="Black"/>

                    <Label Text="Data de Validade:" FontSize="16" TextColor="Black" FontAttributes="Bold"/>
                    <DatePicker x:Name="dp_dataValidade" Format="dd/MM/yyyy" TextColor="Black" />

                </VerticalStackLayout>
            </Frame>

            <Button Text="Salvar Produto" 
                    Clicked="ToolbarItem_Clicked"
                    BackgroundColor="#388E3C" 
                    TextColor="White"
                    FontSize="18"
                    CornerRadius="10"
                    HeightRequest="50"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
